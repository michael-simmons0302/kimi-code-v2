{
  "name": "@moonshot-ai/program-evolution",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluator-guided executable world-model evolution for Kimi Code",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./register": {
      "types": "./src/register.ts",
      "default": "./src/register.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@moonshot-ai/agent-core-v2": "workspace:^"
  }
}
